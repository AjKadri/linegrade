{
  "name": "linegrade",
  "version": "0.1.0",
  "private": true,
  "description": "Invoice-grade card data for B2B sellers: AI-built Level 3 line items on Braintree and PayPal Orders v2 (sandbox).",
  "type": "commonjs",
  "scripts": {
    "test:braintree": "node --env-file=.env braintree-l3-test.js",
    "test:paypal": "node --env-file=.env paypal-l3-test.js",
    "test": "npm run test:braintree; npm run test:paypal",
    "test:unit": "node --test test/*.test.js",
    "web:install": "npm --prefix web install",
    "web:build": "npm --prefix web run build",
    "server": "node server/index.js",
    "demo": "npm --prefix web run build && node server/index.js",
    "screens": "node scripts/screenshots.js",
    "start": "node server/index.js",
    "build": "npm --prefix web ci --include=dev && npm --prefix web run build",
    "coldstart": "node scripts/coldstart.js",
    "check:failures": "node scripts/failure-paths.js",
    "check:sessions": "node scripts/sessions-check.js",
    "check:rerun": "node scripts/rerun-ui-check.js"
  },
  "dependencies": {
    "braintree": "^3.0.0",
    "express": "^5.3.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0"
  }
}
