# Braintree sandbox: sandbox.braintreegateway.com -> Settings (gear) -> API -> API Keys
BT_MERCHANT_ID=
BT_PUBLIC_KEY=
BT_PRIVATE_KEY=

# PayPal sandbox: developer.paypal.com -> Apps & Credentials (Sandbox) -> your app
PP_CLIENT_ID=
PP_CLIENT_SECRET=
# PayPal rail: on by default when both PP_* values are set; PAYPAL_RAIL=off hides it. Without PP_* it is always hidden.
# PAYPAL_RAIL=on

# LLM via OpenRouter (OpenAI-compatible). Set a spend limit on the key in the OpenRouter dashboard.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Default model (M1: Haiku matched Sonnet on accuracy at ~1/15 of the cost)
LLM_MODEL=anthropic/claude-haiku-5.5
# Optional stronger model for comparison runs; leave empty to skip
LLM_MODEL_STRONG=
# Optional: model for the name-normalisation step (defaults to LLM_MODEL)
LLM_MODEL_NORMALIZE=
# Optional client-side cap for eval runs, USD (default 3)
LLM_MAX_SPEND_USD=3

# --- Operating limits (all optional; defaults shown). Set them in the Render dashboard, not in the repo. ---
# LIVE_AI=on                      # "off" switches the live AI re-run off; the frozen-catalog replay keeps working
# LLM_DAILY_CAP_USD=2             # daily LLM spend cap for the live AI re-run
# MAX_RERUNS_PER_SESSION=2        # live AI re-runs per browser session
# MAX_RERUNS_PER_DAY=30           # live AI re-runs per day, all sessions
# MAX_PAYMENTS_PER_SESSION=5      # sandbox payments per browser session
# MAX_PAYMENTS_PER_DAY=200        # sandbox payments per day, all sessions
# RATE_LIMIT_SESSION_PER_MIN=180  # API requests per session per minute
# RATE_LIMIT_IP_PER_MIN=600       # API requests per network address per minute
# SESSION_IDLE_MIN=120            # idle minutes before a session (and its data) is deleted
# ADMIN_TOKEN=                    # optional: enables /api/admin/status and /api/admin/live-ai (Bearer token)
# HOST / PORT                     # Render sets PORT; HOST defaults to 0.0.0.0 in production
